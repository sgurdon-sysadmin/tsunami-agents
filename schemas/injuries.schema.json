{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "injuries.schema.json",
  "title": "injuries",
  "description": "Written by the Medic. Statuses, starting QBs, trades, who gains volume, and external factors.",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "sport": {
      "$ref": "common.schema.json#/$defs/sport"
    },
    "written_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "starters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "team": {
            "$ref": "common.schema.json#/$defs/team"
          },
          "pos": {
            "type": "string"
          },
          "player_name": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "team",
          "pos",
          "player_name",
          "confirmed",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "player_name": {
            "type": "string"
          },
          "team": {
            "$ref": "common.schema.json#/$defs/team"
          },
          "pos": {
            "type": "string"
          },
          "status": {
            "enum": [
              "out",
              "doubtful",
              "questionable",
              "probable",
              "active",
              "inactive",
              "ir",
              "suspended",
              "exempt"
            ]
          },
          "injury": {
            "type": [
              "string",
              "null"
            ]
          },
          "practice": {
            "type": "array",
            "items": {
              "enum": [
                "DNP",
                "LP",
                "FP",
                "-"
              ]
            }
          },
          "game_day_inactive": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "player_name",
          "team",
          "pos",
          "status",
          "injury",
          "practice",
          "game_day_inactive",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "volume_shifts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "team": {
            "$ref": "common.schema.json#/$defs/team"
          },
          "out_player": {
            "type": "string"
          },
          "beneficiaries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "player_name": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "targets",
                    "carries",
                    "red_zone",
                    "minutes",
                    "usage",
                    "snaps"
                  ]
                },
                "boost_points": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 6
                }
              },
              "required": [
                "player_name",
                "role",
                "boost_points"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "team",
          "out_player",
          "beneficiaries",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "player_name": {
            "type": "string"
          },
          "from_team": {
            "type": [
              "string",
              "null"
            ]
          },
          "to_team": {
            "type": [
              "string",
              "null"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "player_name",
          "from_team",
          "to_team",
          "date",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "external": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "factor": {
            "enum": [
              "weather",
              "travel",
              "international",
              "short_week",
              "coaching",
              "locker_room",
              "trade_rumor",
              "other"
            ]
          },
          "detail": {
            "type": "string"
          },
          "affects": {
            "type": "string"
          },
          "adjustment_points": {
            "type": "number",
            "minimum": -3,
            "maximum": 3
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "game_id",
          "factor",
          "detail",
          "affects",
          "adjustment_points",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "url",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "sport",
    "written_at",
    "starters",
    "players",
    "volume_shifts",
    "transactions",
    "external",
    "failures"
  ],
  "additionalProperties": false
}