{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "event",
  "description": "One line of events.jsonl. Every agent and script appends; nobody edits. Feeds the visualization later.",
  "type": "object",
  "properties": {
    "t": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "agent": {
      "enum": [
        "manager",
        "scout",
        "medic",
        "oracle",
        "analyst",
        "scorer",
        "auditor",
        "publisher"
      ]
    },
    "status": {
      "enum": [
        "idle",
        "working",
        "handoff",
        "done",
        "error"
      ]
    },
    "step": {
      "type": "string"
    },
    "msg": {
      "type": "string"
    },
    "file": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "t",
    "run_id",
    "agent",
    "status",
    "step",
    "msg",
    "file"
  ],
  "additionalProperties": false
}