{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "odds.schema.json",
  "title": "odds",
  "description": "Written by the Scout. One row = one side of one market at one book. Same-book pairs are matched later by (game_id, player_name, market, line, book).",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "sport": {
      "$ref": "common.schema.json#/$defs/sport"
    },
    "written_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "feed": {
      "type": "object",
      "properties": {
        "fetched_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "age_minutes": {
          "type": [
            "number",
            "null"
          ]
        },
        "stale": {
          "type": "boolean"
        },
        "games_missing": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/game_id"
          }
        },
        "markets_in_feed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fetched_at",
        "age_minutes",
        "stale",
        "games_missing",
        "markets_in_feed"
      ],
      "additionalProperties": false
    },
    "game_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "book": {
            "$ref": "common.schema.json#/$defs/book"
          },
          "market": {
            "enum": [
              "h2h",
              "spreads",
              "totals",
              "h2h_h1",
              "spreads_h1",
              "totals_h1",
              "h2h_q1",
              "spreads_q1",
              "totals_q1",
              "team_totals",
              "first_to_score",
              "race_to",
              "other_special"
            ]
          },
          "side": {
            "type": "string",
            "description": "Team abbreviation, 'over', 'under', 'yes' or 'no'"
          },
          "team": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/team"
              },
              {
                "type": "null"
              }
            ],
            "description": "For team_totals / race_to: which team"
          },
          "point": {
            "type": [
              "number",
              "null"
            ]
          },
          "price": {
            "$ref": "common.schema.json#/$defs/american_odds"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "game_id",
          "book",
          "market",
          "side",
          "team",
          "point",
          "price",
          "label",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "player_name": {
            "type": "string"
          },
          "team": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/team"
              },
              {
                "type": "null"
              }
            ]
          },
          "market": {
            "type": "string",
            "description": "The Odds API market key, e.g. player_anytime_td, player_tds_over, player_pass_yds, player_rush_yds, player_reception_yds, player_receptions, player_rush_reception_yds, player_1st_half_td, player_2nd_half_td, player_points, player_points_rebounds_assists"
          },
          "side": {
            "enum": [
              "over",
              "under",
              "yes"
            ]
          },
          "line": {
            "type": [
              "number",
              "null"
            ]
          },
          "price": {
            "$ref": "common.schema.json#/$defs/american_odds"
          },
          "book": {
            "$ref": "common.schema.json#/$defs/book"
          },
          "alt": {
            "type": "boolean"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "game_id",
          "player_name",
          "team",
          "market",
          "side",
          "line",
          "price",
          "book",
          "alt",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "lines_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "player_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "markets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "sources_tried": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "game_id",
          "player_name",
          "markets",
          "reason",
          "sources_tried"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "url",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "sport",
    "written_at",
    "feed",
    "game_lines",
    "props",
    "lines_needed",
    "failures"
  ],
  "additionalProperties": false
}