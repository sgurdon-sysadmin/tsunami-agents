{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "models.schema.json",
  "title": "models",
  "description": "Written by the Oracle. Published model numbers only, never prediction-market prices.",
  "type": "object",
  "properties": {
    "run_id": {
      "$ref": "common.schema.json#/$defs/run_id"
    },
    "sport": {
      "$ref": "common.schema.json#/$defs/sport"
    },
    "written_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "game_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "source": {
            "enum": [
              "dimers",
              "espn",
              "numberfire",
              "ftn",
              "scoresandodds",
              "other"
            ]
          },
          "win_prob_home": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/prob"
              },
              {
                "type": "null"
              }
            ]
          },
          "win_prob_away": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/prob"
              },
              {
                "type": "null"
              }
            ]
          },
          "proj_home_pts": {
            "type": [
              "number",
              "null"
            ]
          },
          "proj_away_pts": {
            "type": [
              "number",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "game_id",
          "source",
          "win_prob_home",
          "win_prob_away",
          "proj_home_pts",
          "proj_away_pts",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "player_models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "$ref": "common.schema.json#/$defs/game_id"
          },
          "player_name": {
            "type": "string"
          },
          "team": {
            "anyOf": [
              {
                "$ref": "common.schema.json#/$defs/team"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "enum": [
              "dimers",
              "espn_clay",
              "numberfire",
              "ftn",
              "scoresandodds",
              "other"
            ]
          },
          "stat": {
            "type": "string",
            "description": "anytime_td, first_td, two_plus_td, pass_yds, rush_yds, rec_yds, rush_rec_yds, receptions, points, rebounds, assists, pra, pa, pr, threes"
          },
          "value_type": {
            "enum": [
              "probability",
              "projection"
            ]
          },
          "value": {
            "type": "number"
          },
          "label_confirmed": {
            "type": "boolean",
            "description": "false if the page is unclear (e.g. anytime vs first TD)"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "game_id",
          "player_name",
          "team",
          "source",
          "stat",
          "value_type",
          "value",
          "label_confirmed",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "url",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "run_id",
    "sport",
    "written_at",
    "game_models",
    "player_models",
    "failures"
  ],
  "additionalProperties": false
}